[
    {
        "stepTitle": "OpenSurge",
        "items": [
            {
                "type": "tips",
                "helpText": "修改端口后需要重启 OpenSurge 生效。网卡名 / 局域网 IP 留空会重新自动探测并写回 config.yaml；填写则覆盖对应字段。也可在 Web GUI「网络」页修改。"
            },
            {
                "type": "text",
                "field": "wizard_port",
                "label": "Web GUI 端口",
                "initValue": "61767",
                "rules": [
                    { "required": true, "message": "请填写端口号" },
                    { "pattern": "^([1-9][0-9]{2,4})$", "message": "端口必须是 100-65535 之间的数字" }
                ]
            },
            {
                "type": "text",
                "field": "wizard_interface",
                "label": "网关网卡名",
                "initValue": "",
                "rules": [
                    { "pattern": "^$|^[A-Za-z0-9._-]+$", "message": "网卡名只能包含字母、数字、点、下划线和短横线；留空则自动探测" }
                ]
            },
            {
                "type": "text",
                "field": "wizard_lan_ip",
                "label": "NAS 局域网 IPv4",
                "initValue": "",
                "rules": [
                    { "pattern": "^$|^([0-9]{1,3}\\.){3}[0-9]{1,3}$", "message": "请填写合法的 IPv4 地址；留空则自动探测" }
                ]
            }
        ]
    }
]
