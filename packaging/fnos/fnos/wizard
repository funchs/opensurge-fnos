[
  {
    "step_title": "配置 OpenSurge",
    "items": [
      {
        "type": "textfield",
        "desc": "Web 控制面板端口",
        "subitems": [
          {
            "key": "wizard_port",
            "desc": "端口号",
            "defaultValue": "61767",
            "validator": {
              "allowBlank": false,
              "regex": {
                "expr": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                "errorText": "请输入 1-65535 之间的有效端口号"
              }
            }
          }
        ]
      },
      {
        "type": "multiselect",
        "desc": "注意事项（请务必阅读）",
        "subitems": [
          {
            "key": "wizard_notice_1",
            "desc": "需要 NET_ADMIN 和 SYS_ADMIN 权限，安装前请确保 fnOS Docker 支持 cap_add",
            "defaultValue": true,
            "hidden": true
          },
          {
            "key": "wizard_notice_2",
            "desc": "使用 host 网络模式，可直接管理 NAS 的网络接口和防火墙",
            "defaultValue": true,
            "hidden": true
          },
          {
            "key": "wizard_notice_3",
            "desc": "首次访问需在 Web 界面完成网络配置，详见 /config/config.yaml 注释",
            "defaultValue": true,
            "hidden": true
          }
        ]
      }
    ]
  }
]
