#!/bin/bash
# App-specific lifecycle hooks. Sourced by cmd/installer; helpers come from
# cmd/common.
#
# OpenSurge runs on the host network (bypass-gateway mode needs to see the real
# NIC, create the TUN device and install nftables rules on the host), so the
# listen port comes from OPENSURGE_ADDR in the compose environment, not from a
# `ports:` mapping — those are ignored under network_mode: host.
#
# Network fields (wizard_interface / wizard_lan_ip): empty means "auto-detect
# from the host default route". Non-empty values always win so the user can
# override. fnOS wizard JSON cannot run host scripts before the form is shown,
# so install-time auto-detect happens here after the wizard is submitted.

COMPOSE_FILE="${TRIM_APPDEST}/docker/docker-compose.yaml"
CONFIG_TEMPLATE="${TRIM_APPDEST}/docker/config.fnos.example.yaml"
CONFIG_DIR="${TRIM_PKGVAR}/config"
CONFIG_FILE="${CONFIG_DIR}/config.yaml"
PORT_SAVE="${TRIM_PKGVAR}/.port"
NETWORK_SAVE="${TRIM_PKGVAR}/.network"

# True when the wizard field should be treated as "please auto-detect".
# Empty / whitespace / the literal token "auto" (any case).
is_auto_network_value() {
    local v
    v="$(printf '%s' "${1:-}" | tr -d '[:space:]')"
    case "${v}" in
        ''|auto|Auto|AUTO) return 0 ;;
        *) return 1 ;;
    esac
}

# Prefer the NIC that owns the default IPv4 route (matches real LAN egress).
# Skip virtual/container interfaces that are common false positives on fnOS.
detect_default_interface() {
    local iface="" candidate=""
    local -a candidates=()

    candidate=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{
        for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit }
    }')
    [ -n "${candidate}" ] && candidates+=("${candidate}")

    while read -r candidate; do
        [ -n "${candidate}" ] && candidates+=("${candidate}")
    done < <(ip -4 route show default 2>/dev/null | awk '{
        for (i = 1; i <= NF; i++) if ($i == "dev") print $(i + 1)
    }')

    # Last resort: first non-loopback iface that already has an IPv4 address.
    while read -r candidate; do
        [ -n "${candidate}" ] && candidates+=("${candidate}")
    done < <(ip -4 -o addr show scope global 2>/dev/null | awk '{ print $2 }')

    for candidate in "${candidates[@]}"; do
        case "${candidate}" in
            lo|docker*|br-*|veth*|virbr*|tun*|wg*|tailscale*|zt*|fwbr*|fwpr*|fwln*)
                continue
                ;;
        esac
        if ip link show dev "${candidate}" >/dev/null 2>&1; then
            iface="${candidate}"
            break
        fi
    done

    printf '%s' "${iface}"
}

detect_interface_ipv4() {
    local iface="$1"
    [ -n "${iface}" ] || return 0
    ip -4 -o addr show dev "${iface}" scope global 2>/dev/null | awk '{
        split($4, a, "/"); print a[1]; exit
    }'
}

# Resolve wizard_interface / wizard_lan_ip: keep user overrides, fill blanks
# via host detection. Exports the final values so save_wizard_variables persists
# what was actually applied (including auto-detected ones).
resolve_network_settings() {
    local iface="${wizard_interface:-}"
    local lan_ip="${wizard_lan_ip:-}"
    local detected_iface="" detected_ip=""

    if is_auto_network_value "${iface}"; then
        detected_iface="$(detect_default_interface)"
        if [ -n "${detected_iface}" ]; then
            iface="${detected_iface}"
            install_log "Auto-detected gateway interface=${iface}"
        else
            install_log "WARN: could not auto-detect gateway interface"
            iface=""
        fi
    else
        install_log "Using wizard gateway interface=${iface}"
    fi

    if is_auto_network_value "${lan_ip}"; then
        if [ -n "${iface}" ]; then
            detected_ip="$(detect_interface_ipv4 "${iface}")"
        fi
        if [ -z "${detected_ip}" ]; then
            # Fallback: any global IPv4 on the host (prefer non-docker ranges later)
            detected_ip=$(ip -4 -o addr show scope global 2>/dev/null | awk '{
                split($4, a, "/"); print a[1]; exit
            }')
        fi
        if [ -n "${detected_ip}" ]; then
            lan_ip="${detected_ip}"
            install_log "Auto-detected LAN IPv4=${lan_ip}"
        else
            install_log "WARN: could not auto-detect LAN IPv4"
            lan_ip=""
        fi
    else
        install_log "Using wizard LAN IPv4=${lan_ip}"
    fi

    export wizard_interface="${iface}"
    export wizard_lan_ip="${lan_ip}"

    # Persist a small side file so upgrades / re-config can re-read last applied.
    if [ -n "${iface}" ] || [ -n "${lan_ip}" ]; then
        mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
        {
            echo "wizard_interface=${iface}"
            echo "wizard_lan_ip=${lan_ip}"
        } > "${NETWORK_SAVE}" 2>/dev/null || true
    fi
    return 0
}

# Render the shipped example config with the NIC name and LAN IP from the
# wizard (or auto-detect). Never overwrite an existing config: the user edits
# it from the Web GUI and an upgrade must not throw that away.
seed_config() {
    mkdir -p "${CONFIG_DIR}" "${TRIM_PKGVAR}/state" 2>/dev/null || true

    if [ -f "${CONFIG_FILE}" ]; then
        install_log "Config already present, leaving ${CONFIG_FILE} untouched"
        return 0
    fi
    if [ ! -f "${CONFIG_TEMPLATE}" ]; then
        install_log "Config template missing: ${CONFIG_TEMPLATE}"
        return 0
    fi

    cp "${CONFIG_TEMPLATE}" "${CONFIG_FILE}" || return 0
    apply_network_settings
    install_log "Seeded ${CONFIG_FILE}"
    return 0
}

# Patch gateway.interface / gateway.lan_ip / dns.listen in config.yaml.
# same_lan (bypass gateway) requires upstream_interface == interface.
apply_network_settings() {
    [ -f "${CONFIG_FILE}" ] || return 0

    local iface="${wizard_interface:-}"
    local lan_ip="${wizard_lan_ip:-}"

    if [ -n "${iface}" ]; then
        sed -i "s|^\( *interface: *\).*|\1\"${iface}\"|" "${CONFIG_FILE}"
        sed -i "s|^\( *upstream_interface: *\).*|\1\"${iface}\"|" "${CONFIG_FILE}"
        install_log "Config interface=${iface}"
    fi
    if [ -n "${lan_ip}" ]; then
        sed -i "s|^\( *lan_ip: *\).*|\1\"${lan_ip}\"|" "${CONFIG_FILE}"
        sed -i "s|^\( *listen: *\).*|\1\"${lan_ip}\"|" "${CONFIG_FILE}"
        install_log "Config lan_ip=${lan_ip}"
    fi
    return 0
}

# Rewrite the whole OPENSURGE_ADDR line so this is idempotent whether the value
# is still the ${TRIM_SERVICE_PORT} placeholder or an already-patched literal.
apply_port() {
    local port="$1"
    [ -n "${port}" ] || return 0
    if [ -f "${COMPOSE_FILE}" ]; then
        sed -i "s|^\( *- *OPENSURGE_ADDR=\).*|\10.0.0.0:${port}|" "${COMPOSE_FILE}"
        install_log "Patched compose: OPENSURGE_ADDR=0.0.0.0:${port}"
    fi
    echo "${port}" > "${PORT_SAVE}" 2>/dev/null || true
    return 0
}

service_postinst() {
    resolve_network_settings
    seed_config
    apply_port "${wizard_port:-${TRIM_SERVICE_PORT:-}}"
}

# app.tgz is re-extracted on upgrade, so the compose file is back to the
# template and the saved port has to be re-applied.
service_postupgrade() {
    # Prefer freshly submitted wizard values; fall back to last saved network.
    if [ -f "${NETWORK_SAVE}" ]; then
        load_variables_from_file "${NETWORK_SAVE}"
    fi
    resolve_network_settings
    seed_config
    if [ -f "${PORT_SAVE}" ]; then
        apply_port "$(cat "${PORT_SAVE}")"
    else
        apply_port "${wizard_port:-${TRIM_SERVICE_PORT:-}}"
    fi
}

service_postconfig() {
    resolve_network_settings
    apply_port "${wizard_port:-}"
    # Config wizard may change NIC/IP after install; patch an existing config.
    apply_network_settings
}

# var/ survives uninstall by design; only wipe it when the user asked to.
service_postuninst() {
    if [ "${wizard_delete_data:-false}" = "true" ]; then
        case "${TRIM_PKGVAR}" in
            /vol*|/usr/local/apps/@appdata/*)
                rm -rf "${TRIM_PKGVAR}" 2>/dev/null || true
                install_log "Removed app data at ${TRIM_PKGVAR}"
                ;;
            *)
                install_log "Refusing to remove unexpected TRIM_PKGVAR=${TRIM_PKGVAR}"
                ;;
        esac
    fi
    return 0
}
