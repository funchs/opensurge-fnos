#!/bin/bash

service_postinst() {
    # 创建数据目录
    mkdir -p "${TRIM_PKGVAR}/config" 2>/dev/null || true
    mkdir -p "${TRIM_PKGVAR}/state" 2>/dev/null || true
    mkdir -p "${TRIM_PKGVAR}/mihomo-home" 2>/dev/null || true
    mkdir -p "${TRIM_PKGVAR}/logs" 2>/dev/null || true

    # 复制默认配置（如果不存在）
    if [ ! -f "${TRIM_PKGVAR}/config/config.yaml" ]; then
        cp "${TRIM_APPDEST}/docker/config.fnos.example.yaml" "${TRIM_PKGVAR}/config/config.yaml" 2>/dev/null || true
    fi
}

COMPOSE_FILE="${TRIM_APPDEST}/docker/docker-compose.yaml"
PORT_SAVE="${TRIM_PKGVAR}/.port"

apply_port() {
    local port="$1"
    [ -z "$port" ] && return
    sed -i "s/\"[^\"]*:61767\"/\"${port}:61767\"/" "$COMPOSE_FILE"
    echo "${port}" > "$PORT_SAVE"
    install_log "Patched docker-compose.yaml: port=${port}"
}

service_postupgrade() {
    if [ -f "$PORT_SAVE" ]; then
        apply_port "$(cat "$PORT_SAVE")"
    fi
}

service_postconfig() {
    if [ -n "${wizard_port:-}" ]; then
        apply_port "${wizard_port}"
    fi
}
